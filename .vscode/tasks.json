{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build JARs",
      "type": "process",
      "command": "C:\\Programs\\gradle\\bin\\gradle.bat",
      "args": [
        "-PpzVersion=${input:pzVersion}",
        "packageModJar"
      ],
      "options": {
        "cwd": "${workspaceFolder}/java"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "pzVersion",
      "type": "promptString",
      "description": "Project Zomboid version directory",
      "default": "42.20"
    }
  ]
}
